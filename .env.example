# Supabase (proyecto en región de la UE, p. ej. Frankfurt)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo en el servidor (Vercel). Nunca en el navegador.
SUPABASE_SERVICE_ROLE_KEY=
# URL pública del sitio, para los enlaces de acceso
# Opcional: en Netlify se usa la dirección del sitio automáticamente
NEXT_PUBLIC_SITE_URL=https://cecymethod.com
